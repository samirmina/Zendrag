query adminTicketForms {
  ticketForms {
    id
    title
    endUserTitle
    isActive
    isDefault
    isVisibleByEndUser
    isInAllBrands
    formType
    brands {
      id
    }
    _ticketFieldIds
    ...TicketFormConditionsFragment
  }
}
