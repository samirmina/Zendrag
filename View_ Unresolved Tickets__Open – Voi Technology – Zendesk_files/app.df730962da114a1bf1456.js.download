  ctmStatusGrowlAcknowledgedTimestamp
  disableLotusInterruptiveFeatures
  hasKeyboardShortcuts
  hasMacroShortcuts
  hasSeenSupportSettingsMigrationOnboarding
  hasSeenAppShortcutsPinAppOnboardingTooltip
  hasSeenAppShortcutsRearrangeAppOnboardingTooltip
  hasSeenAppShortcutsUnpinAppOnboardingTooltip
  lotusOnboardingPanelTooltipDismissal
  shouldShowAnswerBotOnboarding
  showAgentHomeOnboarding
  showAgentWorkspaceMessagingOnboarding
  showAgentWorkspaceOnboarding
  showAgentWorkspaceTakeTourTimestamp
  showApplicationsTray
  showComposerWillTranslateFlag
  showComposerWontTranslateFlag
  showCustomerListChonkOnboarding
  showCustomerListReactifiedOnboarding
  showFilteringViewsTableOnboarding
  showFlexibleLayoutTicketContextPanelOnboarding
  showFlexibleLayoutTicketFieldsPanelOnboarding
  showKnowledgeAppOnboarding
  showManualStartTranslationFlag
  showManualStopTranslationFlag
  showOrganizationListChonkOnboarding
  showOrganizationListReactifiedOnboarding
  viewsExpansionBannerDismissal
  showContextualWorkspacePickLayoutTooltip
  guideContentPinningSeenOnboarding
  showCollaborateInConversationTooltip
  showGetHelpViaAtMentionsTooltip
  showStopFollowingConversationTooltip
  showTrackAtMentionsTooltip
  showPublicCommentWarning
  macroTooltipShown
  macroMenuOpenNotificationShown
  macroMenuApplyNotificationShown
  hasSeenEndSessionInOmnicomposerOnboardingTooltip
  agentWorkspaceThemePreference
  agentWorkspaceThemePreferenceForConversationPanel
  showDarkModeOnboardingTooltip
  showAutoReassignAgentTicketsTooltip
  showAgentTasksApprovals
  showAutoAssistFeedbackTooltip
  ticketPreviewStyle
  legacyCCsEOLBannerDismissedAt
  hasNewActivityInSolvedTicketsKeepPersistentNotification
  hasNewActivityInSolvedTicketsNotification
  agentHomePinnedViews
  notificationVolume

  # For Ember Resource Link only, if you need any of these attribute
  # in React, move it to the block above
  hasDeviceNotification
  showReportingVideoTutorial
  showUserNavTooltip
  showNewUserProfile
  isFirstTimeAssumingUser
  showInsightsOnboarding
  voiceCallingNumber
  voiceSelectedRingtone
  voiceRingtoneVolume
  ticketActionOnSave
  hasTwoFactorAuthentication
  showPredictionSatisfactionDashboard
  showOnboardingModal
  showWelcomeDialog
  lastLotusLogin
  hasSeenBulkActionsRefresh
}
