subscription workloadUpdateNotification {
  workloadUpdateNotification {
    id
    timestamp
    ticket {
      id
    }

    ... on MessageAddedWorkloadNotification {
      actor {
        id
        name
      }
      channel
      content
      lastContentActor {
        id
        name
      }
      relationship
      requester {
        id
        name
        nameMaskable {
          __typename
        }
      }
      lastContentTimestamp
    }

    ... on MessageMentionedWorkloadNotification {
      actor {
        id
        name
      }
      channel
      content
      lastContentActor {
        id
        name
      }
      relationship
      requester {
        id
        name
        nameMaskable {
          __typename
        }
      }
      lastContentTimestamp
    }

    ... on TicketAssignedWorkloadNotification {
      actor {
        id
        name
      }
      channel
      lastMessage: content
      lastMessageActor: lastContentActor {
        id
        name
      }
      relationship
      requester {
        id
        name
        nameMaskable {
          __typename
        }
      }
      lastMessageTimestamp: lastContentTimestamp
    }
  }
}
