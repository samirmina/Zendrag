AClB,cAAc;EACd,mBAAmB;EACnB,oCAAoC;EACpC,cAAc;EACd,aAAa;EACb,eAAe;EACf,qDAAqD;AACvD;;AAEA;EACE,mCAAmC;AACrC;;AAEA;;;EAGE,mCAAmC;EACnC,iCAAiC;AACnC;;AAEA;EACE,aAAa;AACf;;AAEA;EACE,+CAA+C;EAC/C,oBAAoB;EACpB,kBAAkB;AACpB;;AAEA;EACE,iBAAiB;AACnB;;AAEA;EACE,UAAU;AACZ",sourcesContent:[`/* Disclosure (accordion + tabs progressive-enhancement base).

   Themeable custom properties (stable API):
     --zd-wysiwyg-disclosure-border-color — hairline color between panels
       (also reused as the tabs baseline hairline).
     --zd-wysiwyg-disclosure-header-bg — resting background of the summary.
     --zd-wysiwyg-disclosure-header-bg-hover — hovered background of the
       summary.
     --zd-wysiwyg-disclosure-transition-duration — duration of disclosure
       transitions, including the summary hover, chevron rotation, and panel
       expansion/collapse.

   \`.wysiwyg-disclosure\` is the legacy wrapper; use \`zd-accordion\` or
   \`zd-tabs\` instead.
*/

.wysiwyg-disclosure,
zd-accordion,
zd-tabs {
  --zd-wysiwyg-disclosure-border-color: #d8dcde;
  --zd-wysiwyg-disclosure-header-bg: transparent;
  --zd-wysiwyg-disclosure-header-bg-hover: transparent;
  --zd-wysiwyg-disclosure-transition-duration: 200ms;

  display: block;
  interpolate-size: allow-keywords;
  -webkit-margin-after: 1em;
          margin-block-end: 1em;
}

[data-hc-color-scheme="dark"] .wysiwyg-disclosure,
[data-hc-color-scheme="dark"] zd-accordion,
[data-hc-color-scheme="dark"] zd-tabs,
[data-color-scheme="dark"] .wysiwyg-disclosure,
[data-color-scheme="dark"] zd-accordion,
[data-color-scheme="dark"] zd-tabs {
  --zd-wysiwyg-disclosure-border-color: #39434b;
}

.wysiwyg-disclosure > details + details,
zd-accordion > details + details,
zd-tabs > details + details {
  border-top: 1px solid var(--zd-wysiwyg-disclosure-border-color);
}

.wysiwyg-disclosure > details > summary:not([hidden]),
zd-accordion > details > summary:not([hidden]),
zd-tabs > details > summary:not([hidden]) {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 0;
  background-color: var(--zd-wysiwyg-disclosure-header-bg);
  font-weight: 600;
  transition: background-color var(--zd-wysiwyg-disclosure-transition-duration)
    ease;
}

.wysiwyg-disclosure > details[hidden],
.wysiwyg-disclosure > details > summary[hidden],
zd-accordion > details[hidden],
zd-accordion > details > summary[hidden],
zd-tabs > details[hidden],
zd-tabs > details > summary[hidden] {
  display: none;
}

.wysiwyg-disclosure > details > summary::-webkit-details-marker,
zd-accordion > details > summary::-webkit-details-marker,
zd-tabs > details > summary::-webkit-details-marker {
  display: none;
}

.wysiwyg-disclosure > details > summary:hover,
zd-accordion > details > summary:hover,
zd-tabs > details > summary:hover {
  background-color: var(--zd-wysiwyg-disclosure-header-bg-hover);
}

.wysiwyg-disclosure > details > summary::after,
zd-accordion > details > summary::after,
zd-tabs > details > summary::after {
  content: "";
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  background-color: currentColor;
  -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><path fill='none' stroke='black' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M4 6l4 4 4-4'/></svg>");
  mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><path fill='none' stroke='black' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M4 6l4 4 4-4'/></svg>");
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  transition: transform var(--zd-wysiwyg-disclosure-transition-duration) ease;
}

.wysiwyg-disclosure > details[open] > summary::after,
zd-accordion > details[open] > summary::after,
zd-tabs > details[open] > summary::after {
  transform: rotate(180deg);
}

.wysiwyg-disclosure > details > .wysiwyg-disclosure-content,
zd-accordion > details > .wysiwyg-disclosure-content,
zd-tabs > details > .wysiwyg-disclosure-content {
  padding: 4px 0 10px;
}

.wysiwyg-disclosure > details::details-content,
zd-accordion > details::details-content,
zd-tabs > details::details-content {
  block-size: 0;
  overflow: hidden;
  transition: block-size var(--zd-wysiwyg-disclosure-transition-duration) ease,
    content-visibility var(--zd-wysiwyg-disclosure-transition-duration) ease
      allow-discrete;
}

.wysiwyg-disclosure > details[open]::details-content,
zd-accordion > details[open]::details-content,
zd-tabs > details[open]::details-content {
  block-size: auto;
}

/* Callouts — 4 variants: info, warning, error, tip.
   Icons are the Garden 16px stroke icons copied inline as SVG data URIs
   and applied via mask-image so \`--zd-wysiwyg-callout-{type}-icon-color\`
   tints them independently.

   Themeable custom properties (stable API):
     --zd-wysiwyg-callout-border-radius — corner radius of the container.
     --zd-wysiwyg-callout-icon-size — square size of the variant icon.
   Per variant, where {type} is one of info, warning, error, tip:
     --zd-wysiwyg-callout-{type}-bg
     --zd-wysiwyg-callout-{type}-icon-color
     --zd-wysiwyg-callout-{type}-icon         (SVG url(), applied as a mask)

   \`.wysiwyg-callout\` and \`.wysiwyg-callout-{type}\` are the legacy classes use
   \`zd-callout[data-type="{type}"]\` instead.
*/

.wysiwyg-callout,
zd-callout {
  --zd-wysiwyg-callout-border-radius: 4px;
  --zd-wysiwyg-callout-icon-size: 16px;

  --zd-wysiwyg-callout-info-bg: #e9ebed;
  --zd-wysiwyg-callout-info-icon-color: #68737d;
  --zd-wysiwyg-callout-info-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><g stroke='black'><circle cx='7.5' cy='8.5' r='7' fill='none'/><path stroke-linecap='round' d='M7.5 12.5V8'/></g><circle cx='7.5' cy='5' r='1' fill='black'/></svg>");

  --zd-wysiwyg-callout-warning-bg: #fdf6e7;
  --zd-wysiwyg-callout-warning-icon-color: #c38f00;
  --zd-wysiwyg-callout-warning-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><path fill='none' stroke='black' stroke-linecap='round' d='M.88 13.77L7.06 1.86c.19-.36.7-.36.89 0l6.18 11.91c.17.33-.07.73-.44.73H1.32c-.37 0-.61-.4-.44-.73zM7.5 6v3.5'/><circle cx='7.5' cy='12' r='1' fill='black'/></svg>");

  --zd-wysiwyg-callout-error-bg: #fff0f1;
  --zd-wysiwyg-callout-error-icon-color: #cc3340;
  --zd-wysiwyg-callout-error-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><g fill='none' stroke='black'><circle cx='7.5' cy='8.5' r='7'/><path stroke-linecap='round' d='M7.5 4.5V9'/></g><circle cx='7.5' cy='12' r='1' fill='black'/></svg>");

  --zd-wysiwyg-callout-tip-bg: #edf8f4;
  --zd-wysiwyg-callout-tip-icon-color: #228f67;
  --zd-wysiwyg-callout-tip-icon: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><g fill='none' stroke='black'><path d='M5.5 10.997a4.955 4.955 0 01-3-4.542c0-2.738 2.24-4.955 5-4.955s5 2.217 5 4.955a4.955 4.955 0 01-3 4.542V12.5h-4v-1.503z'/><path stroke-linejoin='round' d='M6.5 7.5h2-2zm1 0V10 7.5z'/></g><path fill='black' d='M5 14h5v.727C10 15.43 9.43 16 8.727 16H6.273C5.57 16 5 15.43 5 14.727V14z'/></svg>");

  display: grid;
  grid-template-columns: 16px 1fr;
  grid-template-columns: var(--zd-wysiwyg-callout-icon-size) 1fr;
  grid-column-gap: 8px;
  -moz-column-gap: 8px;
       column-gap: 8px;
  align-items: start;
  -webkit-margin-after: 1em;
          margin-block-end: 1em;
  border-radius: 4px;
  border-radius: var(--zd-wysiwyg-callout-border-radius);
  background-color: var(--zd-wysiwyg-callout-bg);
  padding: 16px 20px;
}

[data-hc-color-scheme="dark"] .wysiwyg-callout,
[data-hc-color-scheme="dark"] zd-callout,
[data-color-scheme="dark"] .wysiwyg-callout,
[data-color-scheme="dark"] zd-callout {
  --zd-wysiwyg-callout-info-bg: #262d36;
  --zd-wysiwyg-callout-info-icon-color: #8b96a1;

  --zd-wysiwyg-callout-warning-bg: #3a2a13;
  --zd-wysiwyg-callout-warning-icon-color: #f0a63e;

  --zd-wysiwyg-callout-error-bg: #3a1620;
  --zd-wysiwyg-callout-error-icon-color: #e2707d;

  --zd-wysiwyg-callout-tip-bg: #10281f;
  --zd-wysiwyg-callout-tip-icon-color: #5fbf98;
}

.wysiwyg-callout > .wysiwyg-callout-icon,
zd-callout > .wysiwyg-callout-icon {
  flex-shrink: 0;
  width: var(--zd-wysiwyg-callout-icon-size);
  /* Occupy at least one line of text so the default icon visually centers
     on the first line while multi-line content stays top-aligned. */
  height: max(1lh, var(--zd-wysiwyg-callout-icon-size));
  background-color: var(--zd-wysiwyg-callout-icon-color);
  -webkit-mask-image: var(--zd-wysiwyg-callout-icon);
  mask-image: var(--zd-wysiwyg-callout-icon);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.wysiwyg-callout > .wysiwyg-callout-icon ~ *,
zd-callout > .wysiwyg-callout-icon ~ * {
  grid-column: 2;
  margin-top: 0;
}

.wysiwyg-callout > :last-child,
zd-callout > :last-child {
  margin-bottom: 0;
}

.wysiwyg-callout-info,
zd-callout[data-type="info"] {
  --zd-wysiwyg-callout-bg: var(--zd-wysiwyg-callout-info-bg);
  --zd-wysiwyg-callout-icon-color: var(--zd-wysiwyg-callout-info-icon-color);
  --zd-wysiwyg-callout-icon: var(--zd-wysiwyg-callout-info-icon);
}

.wysiwyg-callout-warning,
zd-callout[data-type="warning"] {
  --zd-wysiwyg-callout-bg: var(--zd-wysiwyg-callout-warning-bg);
  --zd-wysiwyg-callout-icon-color: var(--zd-wysiwyg-callout-warning-icon-color);
  --zd-wysiwyg-callout-icon: var(--zd-wysiwyg-callout-warning-icon);
}

.wysiwyg-callout-error,
zd-callout[data-type="error"] {
  --zd-wysiwyg-callout-bg: var(--zd-wysiwyg-callout-error-bg);
  --zd-wysiwyg-callout-icon-color: var(--zd-wysiwyg-callout-error-icon-color);
  --zd-wysiwyg-callout-icon: var(--zd-wysiwyg-callout-error-icon);
}

.wysiwyg-callout-tip,
zd-callout[data-type="tip"] {
  --zd-wysiwyg-callout-bg: var(--zd-wysiwyg-callout-tip-bg);
  --zd-wysiwyg-callout-icon-color: var(--zd-wysiwyg-callout-tip-icon-color);
  --zd-wysiwyg-callout-icon: var(--zd-wysiwyg-callout-tip-icon);
}

/* Tabs — progressive-enhancement styling applied only once the runtime
   adds \`.wysiwyg-tabs-active\` to the tabs element (or to the legacy
   \`.wysiwyg-tabs\` container). Until then, both structures render as a plain
   disclosure/accordion.

   Themeable custom properties (stable API):
     --zd-wysiwyg-tabs-color — accent color for the selected tab's text,
       underline, and focus ring.
*/

.wysiwyg-tabs-active {
  --zd-wysiwyg-tabs-color: currentColor;
}

/* Suppress the accordion separator between the collapsed panels once tabs
   have upgraded — panels are toggled via \`hidden\` and rendered as a
   single-panel area. */

.wysiwyg-tabs-active > details + details {
  border-top: 0;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar {
  border-bottom: 1px solid var(--zd-wysiwyg-disclosure-border-color);
  display: flex;
  max-width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar::-webkit-scrollbar {
  display: none;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar > .wysiwyg-tabs-tab {
  -webkit-appearance: none;
     -moz-appearance: none;
          appearance: none;
  background: transparent;
  border: 0;
  padding: 10px 20px;
  flex: 0 0 auto;
  white-space: nowrap;
  border-bottom: 3px solid transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
  transition: color 100ms ease, border-color 100ms ease;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar > .wysiwyg-tabs-tab:hover {
  color: var(--zd-wysiwyg-tabs-color);
}

.wysiwyg-tabs-active
  > .wysiwyg-tabs-bar
  > .wysiwyg-tabs-tab[aria-selected="true"] {
  color: var(--zd-wysiwyg-tabs-color);
  border-bottom-color: currentColor;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar > .wysiwyg-tabs-tab:focus {
  outline: none;
}

.wysiwyg-tabs-active > .wysiwyg-tabs-bar > .wysiwyg-tabs-tab:focus-visible {
  outline: 2px solid var(--zd-wysiwyg-tabs-color);
  outline-offset: -2px;
  border-radius: 2px;
}

