      regexpForValidation
    }
    ... on LookupTicketField {
      relationshipTargetType
      relationshipFilter {
        all {
          field
          operator
          value
        }
        any {
          field
          operator
          value
        }
      }
    }
    ... on MultiLookupTicketField {
      relationshipTargetType
      relationshipFilter {
        all {
          field
          operator
          value
        }
        any {
          field
          operator
          value
        }
      }
      maxSelections
    }
    ... on CheckboxTicketField {
      tag
    }
    ... on PriorityTicketField {
      priorityOptionType
      options {
        name
        value
      }
    }
    ... on TicketTypeTicketField {
      options {
        name
        value
      }
    }
    ... on StatusTicketField {
      statusOptionType
    }
    ... on CustomStatusTicketField {
      customStatuses {
        id
        url
        agentLabel
        statusCategory
      }
    }
  }
}
