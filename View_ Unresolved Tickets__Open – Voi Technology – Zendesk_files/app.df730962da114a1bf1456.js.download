  chatConversationByIssueId(issueId: $issueId) {
    id
    customer {
      displayName
    }
    state
    sourceType
    events {
      edges {
        node {
          id
          actorType
          timestamp
          ... on ChatMessageEvent {
            actorId
            actorDisplayName
            message
            messageId
            index
            optimisticUpdate @client {
              isOptimistic @client
              status @client
              timestamp @client
            }
          }
          ... on ChatJoinEvent {
            actorId
            actorDisplayName
          }
          ... on ChatLeaveEvent {
            actorId
            actorDisplayName
          }
          ... on ChatFileEvent {
            actorId
            actorDisplayName
            mimeType
            filename
            url
            index
          }
          ... on ChatRatingEvent {
            actorId
            actorDisplayName
            newRating
            oldRating
          }
          ... on ChatRatingCommentEvent {
            actorId
            actorDisplayName
            comment
          }
          ... on ChatRequestRatingEvent {
            actorId
            actorDisplayName
          }
          ... on ChatNameChangeEvent {
            actorId
            actorDisplayName
            userNewDisplayName
            userOldDisplayName
          }
          ... on ChatEmailChangeEvent {
            actorId
            actorDisplayName
            userNewEmail
            userOldEmail
          }
          ... on ChatDepartmentTransferEvent {
            actorId
            actorDisplayName
            departmentName
          }
          ... on ChatMessageStatusEvent {
            statusTimestamp
            messageStatus
            parentMessageIndex
          }
        }
      }
    }
  }
}
