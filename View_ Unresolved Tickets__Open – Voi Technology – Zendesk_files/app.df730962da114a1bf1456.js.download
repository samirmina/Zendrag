    chatSidebar {
      ...AppMarketAppInfo
    }
    modal {
      ...AppMarketAppInfo
    }
    ticketEditor {
      ...AppMarketAppInfo
    }
    systemTopBar {
      ...AppMarketAppInfo
    }
    customObjectRecordSidebar {
      ...AppMarketAppInfo
    }
  }
}

fragment AppMarketAppInfo on AppMarketApp {
  id
  name
  logo
  installUrl
  detailsUrl
  paid
  description
  rating {
    totalCount
    average
  }
  plan {
    amount
    planType
  }
}
