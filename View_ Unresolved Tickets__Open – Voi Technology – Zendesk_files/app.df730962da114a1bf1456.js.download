  chatConversationByIssueId(issueId: $issueId) {
    id
    state
    lastReadTimestamps {
      actorId
      timestamp
    }
    sourceType
    customer {
      id
      identity {
        provider
      }
    }
    agents {
      edges {
        node {
          id
        }
      }
    }
    events {
      edges {
        node {
          id
          actorType
          timestamp
          ... on ChatMessageEvent {
            actorId
            actorSupportId
            actorDisplayName
            messageSource
            message
            messageId
            index
            optimisticUpdate @client {
              isOptimistic @client
              status @client
              timestamp @client
            }
            translation {
              message
            }
          }
          ... on ChatMessageStatusEvent {
            parentMessageIndex
            messageStatus
            statusTimestamp
          }
          ... on ChatJoinEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatLeaveEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatFileEvent {
            actorId
            actorSupportId
            actorDisplayName
            messageId
            messageSource
            mimeType
            filename
            url
            index
            supportAttachmentId
          }
          ... on ChatRatingEvent {
            actorId
            actorDisplayName
            newRating
            oldRating
          }
          ... on ChatRatingCommentEvent {
            actorId
            actorDisplayName
            comment
          }
          ... on ChatRequestRatingEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatNameChangeEvent {
            actorId
            actorSupportId
            actorDisplayName
            userNewDisplayName
            userOldDisplayName
          }
          ... on ChatEmailChangeEvent {
            actorId
            actorSupportId
            actorDisplayName
            userNewEmail
            userOldEmail
          }
          ... on ChatDepartmentTransferEvent {
            actorId
            actorSupportId
            actorDisplayName
            departmentName
          }
        }
      }
    }
  }
