tGraphChatMessageEventFragment.gql'

query conversationServiceQuery($issueId: ID!) {
  chatConversationByIssueId(issueId: $issueId) {
    agents {
      edges {
        node {
          id
        }
      }
    }
    browser
    city
    country
    customer {
      id
      displayName
      identity {
        provider
      }
      sunco {
        userExternalId
      }
    }
    id
    lastMessage
    lastMessageTimestamp
    lastReadTimestamps {
      actorId
      timestamp
    }
    state
    typingStatus {
      actorId
      actorSupportId
      actorType
      isTyping
    }
    sourceType
    events {
      edges {
        node {
          id
          actorType
          timestamp
          ... on ChatMessageEvent {
            ...ChatMessageEventFragment
          }
          ... on ChatJoinEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatLeaveEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatFileEvent {
            actorId
            actorSupportId
            actorDisplayName
            messageId
            messageSource
            mimeType
            filename
            url
            index
            supportAttachmentId
          }
          ... on ChatRatingEvent {
            actorId
            actorDisplayName
            newRating
            oldRating
          }
          ... on ChatRatingCommentEvent {
            actorId
            actorDisplayName
            comment
          }
          ... on ChatRequestRatingEvent {
            actorId
            actorSupportId
            actorDisplayName
          }
          ... on ChatNameChangeEvent {
            actorId
            actorSupportId
            actorDisplayName
            userNewDisplayName
            userOldDisplayName
          }
          ... on ChatEmailChangeEvent {
            actorId
            actorSupportId
            actorDisplayName
            userNewEmail
            userOldEmail
          }
          ... on ChatDepartmentTransferEvent {
            actorId
            actorSupportId
            actorDisplayName
            departmentName
          }
          ... on ChatMessageStatusEvent {
            statusTimestamp
            messageStatus
            parentMessageIndex
          }
        }
      }
    }
  }
}
