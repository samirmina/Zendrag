}

type SideConversationsResultRow {
  id: ID!
  participants: [String]
  status: String
  sideConversation: SideConversation
  subject: String
  ticketId: String
}

union RowsResult =
  | TicketsResultRow
  | ArticlesResultRow
  | UsersResultRow
  | OrganizationsResultRow
  | SideConversationsResultRow

type SearchResult {
  columns: [SearchResultColumn]!
  count: Int!
  facets: FacetCounts
  rows: [RowsResult]!
}

extend type Query {
  searchBox(query: String!): SearchBox
