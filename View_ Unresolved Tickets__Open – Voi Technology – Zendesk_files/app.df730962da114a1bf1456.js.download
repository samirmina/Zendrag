    body {
      font-family: ${e.fonts.system};
      font-size: ${e.fontSizes.md};
    }

    h2, h3 {
      margin-bottom: 0;
    }

    h2 {
      margin-top: ${e.space.xs};
    }

    h3 {
      margin-top: 0;
    }

    p, dt, dd {
      margin-top: ${e.space.xs};
      font-size: inherit;
    }

    .word-break {
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .print-color-adjust {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  `,tf=(e,t)=>`
    #title {
      margin: ${e.space.sm};
      text-align: left;
    }
    body[dir='rtl'] #title {
      text-align: right;
    }

    .logo {
      ${tk("margin-right",e.space.sm)}
      float: left;
    }
    body[dir='rtl'] .logo {
      float: right;
    }

    .logo svg {
      height: 26px;
      width: 26px;
      transition: color .4s, fill .4s;
      font-size: 26px;
      fill: ${t.logoFill};
      color: ${t.logoColor};
    }

    footer, #comments {
      border-top: 2px solid ${t.borderEmphasis};
    }

    footer {
      color: ${t.foregroundSubtle};
      font-weight: ${e.fontWeights.semibold};
      text-align: center;
      margin-top: ${e.space.xs};
    }

    #info, #fields {
      display: flex;
      flex-wrap: wrap;
      margin-bottom: ${e.space.xs};
    }

    #info {
      border-top: 2px solid ${t.borderEmphasis};
      padding: ${e.space.xs} ${e.space.sm} 0;
    }

    #fields {
      padding: 0 ${e.space.sm};
    }

    #ccs {
      padding: ${e.space.xs} ${e.space.sm} ${e.space.xs};
    }

    .comment:not(:last-child) {
      border-bottom: ${e.borderWidths.sm} dashed ${t.borderEmphasis};
    }
  `,t_=(e,t)=>`
    dl {
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: ${e.space.md};
    }

    dl > div {
      display: block;
    }

    dt {
      font-weight: ${e.fontWeights.semibold};
      margin: 0;
      margin-bottom: ${e.space.xxs};
    }

    dd,
    #ccs p {
      margin: 0;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .field-separator {
      border: none;
      border-top: ${e.borderWidths.sm} dashed ${t.borderEmphasis};
      margin: ${e.space.sm} 0;
      width: 100%;
      flex-basis: 100%;
    }
  `,tb=(e,t)=>`
    #comments {
      margin-top: 0;
    }
    .comment {
      margin: 0;
      padding: ${e.space.xs} ${e.space.sm} ${e.space.sm};
    }
    .comment:last-child {
      padding-bottom: 0;
    }
    .mast {
      position: relative;
      margin-bottom: ${e.space.xs};
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .comment-metadata {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: ${e.space.xs};
    }
    .comment-badges {
      display: flex;
      gap: ${e.space.xs};
      margin-inline-start: auto;
    }
    .conversation-info {
      color: ${t.foregroundSubtle};
      font-size: ${e.fontSizes.sm};
      font-style: italic;
    }
    .comment .body {
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .comment .body * {
      page: auto !important;
    }
    .author {
      font-weight: ${e.fontWeights.semibold};
    }
    .date {
      color: ${t.foregroundSubtle};
      font-size: ${e.fontSizes.sm};
      ${tg("padding-left",e.space.xs)}
    }
    body[dir='rtl'] .date {
      display: inline-block;
    }

    .internal_note {
      display: inline-block;
      color: ${t.foregroundOnEmphasis};
      font-size: ${e.fontSizes.sm};
      line-height: ${e.lineHeights.sm};
      padding: ${e.space.xxs} ${e.space.xs};
      background-color: ${t.internalNoteLabelBackground};
      border-radius: ${e.borderRadii.md};
    }
    @media print {
      .internal_note {
        background-color: ${t.internalNoteLabelBackground} !important;
        color: ${t.foregroundOnEmphasis} !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    .comment h1, .comment h2, .comment h3,
    .comment h4, .comment h5, .comment h6 {
      color: ${t.foregroundDefault};
      font-weight: ${e.fontWeights.semibold};
      margin: ${e.space.xs} 0;
      text-transform: none;
    }
    .comment h1 {
      font-size: ${e.fontSizes.xl};
      margin: ${e.space.xs} 0 ${e.space.md};
      line-height: ${e.lineHeights.xl};
    }
    .comment h2 {
      font-size: ${e.fontSizes.lg};
      margin: ${e.space.xs} 0 ${e.space.sm};
