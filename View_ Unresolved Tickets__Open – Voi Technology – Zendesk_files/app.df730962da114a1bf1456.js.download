  satisfactionScore: String
  slaNextBreachAt: SlaNextBreachAt
  lookupTickets: [LookupTickets]
  solved: String
  status: String
  statusGroupLabel: String
  subject: String
  supportType: String
  submitter: String
  ticketForm: String
  type: String
  updated: String
  updatedByType: String
  via: Via
  viaId: Int
  viewId: ID!
}

type ViewTicketColumn {
  id: ID!
  sortable: Boolean
  title: String
  type: String
  target_type: String
  filterable: Boolean
}

type MetaCBP {
  hasMore: Boolean
  afterCursor: String
  beforeCursor: String
  lastCursor: String
}

type relatedTicket {
  id: ID!
  subject: String
}

type ViewTicketsResult {
  columns: [ViewTicketColumn]
  count: Int
  meta: MetaCBP
  defaultSortBy: DefaultSortBy
  groupBy: GroupBy
  rows: [ViewTicket]
  title: String
  relatedTickets: [relatedTicket]
}

extend type Query {
  showManyLookupTickets(ticketIds: [ID]): [ShowManyLookupTickets]
  hydrateTickets(
    ticketIds: [ID]
    hasSLAColumn: Boolean
    hasGroupSLAColumn: Boolean
    currentView: String
  ): [HydrateTickets]
  skillMatch(ticketIds: [ID]): [ID]
  viewTickets(
    viewId: ID!
    hasSkill: Boolean!
    page: Int
    perPage: Int
    sortBy: String
    sortOrder: String
    groupBy: String
    currentUserId: ID
    optionsConditions: JSON
    cursor: JSON
  ): ViewTicketsResult!
}
