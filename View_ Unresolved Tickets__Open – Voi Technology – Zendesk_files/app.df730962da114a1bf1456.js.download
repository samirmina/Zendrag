  brands {
    id
    url
    name
    brandUrl
    isActive

    # Used by Ember Resource link
    subdomain
    isDefault
    isDeleted
    hasHelpCenter
    helpCenterState
    hostMapping
    userSeparation
    logo {
      id
      url
      size
      contentType
      contentUrl
      mappedContentUrl
      thumbnails {
        id
        fileName
        contentType
        size
        contentUrl
      }
    }
    _ticketFormIds
