type Attachment {
  contentType: String!
  contentUrl: String!
  createdAt: String!
  filename: String!
  size: Int!
}

type FailedAttachment {
  reason: String!
}

union AttachmentFetch = Attachment | FailedAttachment

type Macro {
  id: ID!
