query autocompleteUsers(
  $query: String!
  $first: Int = 30
  $filter: String
  $options: UserQueryOptions = {}
) {
  autocompleteUsers(query: $query, first: $first, filter: $filter, options: $options) {
    id
    name
    email
    avatar
    role
    roleInfo {
      ...RoleFields
    }
    roleType
    suspended
    blocklisted
    isNameMasked
    isEmailMasked
    isPhoneMasked
    alias
    details
    externalId
    groups {
      id
      name
    }
    identities {
      id
      type
      value
      verified
      primary
      userId
      undeliverableCount
      deliverableState
    }
    locale
    notes
    organizations {
      details
      domainNames
      externalId
      groupId
      sharedComments
      sharedTickets
      id
      name
      notes
      tags
    }
    signature
    tags
    timeZone {
      formattedOffset
      ianaName
      name
      offset
      translatedName
    }
  }
}
