),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){n(e,t)}),e.definitions&&e.definitions.forEach(function(e){n(e,t)})}t.loc.source={body:`# Unfortunately, it seems like Fragments on polymorphic queries don't work,
# so we need to define the exact same query under agentConditions and
# endUserConditions.

fragment TicketFormConditionsFragment on TicketForm {
  id
  agentConditions {
    parentField {
      id
      title
      endUserPermission
      ... on DropdownTicketField {
        customFieldOptions {
          id
          name
          value
        }
      }
      ... on PriorityTicketField {
        priorityOptionType
        options {
          name
          value
        }
      }
      ... on TicketTypeTicketField {
        options {
          name
          value
        }
      }
    }

    childFields {
      ticketField {
        id
        title
        endUserPermission
      }

      ... on AgentConditionChild {
        requiredOnStatuses {
          ... on RequiredOnSomeStatuses {
            statuses
            customStatuses
          }
        }
      }
    }

    ... on TicketFormDropdownCondition {
      selectedOption {
        value
        isValid
        customFieldOption {
          id
          name
        }
      }
    }
    ... on TicketFormPriorityCondition {
      priority {
        name
        value
      }
    }
    ... on TicketFormTicketTypeCondition {
      ticketType {
        name
        value
      }
    }
    ... on TicketFormCheckboxCondition {
      isChecked
    }
    ... on TicketFormTextCondition {
      text
    }
    ... on TicketFormMultilineCondition {
      paragraph
    }
  }
  endUserConditions {
    parentField {
      id
      title
      endUserPermission
      ... on DropdownTicketField {
        customFieldOptions {
          id
          name
          value
        }
      }
      ... on PriorityTicketField {
        priorityOptionType
        options {
          name
          value
        }
      }
      ... on TicketTypeTicketField {
        options {
          name
          value
        }
      }
    }

    childFields {
      ticketField {
        id
        title
        endUserPermission
      }

      ... on EndUserConditionChild {
        isRequired
      }
    }

    ... on TicketFormDropdownCondition {
      selectedOption {
        value
        isValid
        customFieldOption {
          id
          name
          value
        }
      }
    }
    ... on TicketFormPriorityCondition {
      priority {
        name
        value
      }
    }
    ... on TicketFormTicketTypeCondition {
      ticketType {
        name
        value
      }
    }
    ... on TicketFormCheckboxCondition {
      isChecked
    }
    ... on TicketFormTextCondition {
      text
    }
    ... on TicketFormMultilineCondition {
      paragraph
    }
  }
}
