  ${t.fg&&`color: ${t.fg};`}
  ${t.bg&&`background-color: ${t.bg};`}
  ${t.border&&`border-color: ${t.border};`}

  &:hover {
    ${t.hoverFg&&`color: ${t.hoverFg};`}
    ${t.hoverBg&&`background-color: ${t.hoverBg};`}
    ${t.hoverBorder&&`border-color: ${t.hoverBorder};`}
  }

  &:active,
  &[aria-pressed='true'],
  &[aria-pressed='mixed'] {
    ${t.activeFg&&`color: ${t.activeFg};`}
    ${t.activeBg&&`background-color: ${t.activeBg};`}
    ${t.activeBorder&&`border-color: ${t.activeBorder};`}
