interface TicketFormConditionChild {
  ticketField: TicketField!
}

# An interface defining the structure of a TicketFormCondition
interface TicketFormCondition {
  _parentFieldId: ID!
  parentField: TicketField!
  childFields: [TicketFormConditionChild!]!
}

type TicketFormTextCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: TextTicketField!
  childFields: [TicketFormConditionChild!]!
  text: String!
}

type TicketFormMultilineCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: MultilineTicketField!
  childFields: [TicketFormConditionChild!]!
  paragraph: String!
}

type TicketFormCheckboxCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: CheckboxTicketField!
  childFields: [TicketFormConditionChild!]!
  isChecked: Boolean!
}

type TicketFormPriorityCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: PriorityTicketField!
  childFields: [TicketFormConditionChild!]!
  priority: SystemFieldOption!
}

type TicketFormTicketTypeCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: TicketTypeTicketField!
  childFields: [TicketFormConditionChild!]!
  ticketType: SystemFieldOption!
}

type SelectedCustomFieldOption {
  value: String!
  customFieldOption: CustomFieldOption
  isValid: Boolean!
}

type TicketFormDropdownCondition implements TicketFormCondition {
  _parentFieldId: ID!
  parentField: DropdownTicketField!
  childFields: [TicketFormConditionChild!]!
  selectedOption: SelectedCustomFieldOption!
}

# TicketForm type
type TicketForm {
  id: ID!
  title: String!
  rawTitle: String!
  endUserTitle: String
  rawEndUserTitle: String
  isActive: Boolean!
  isDefault: Boolean!
  deletedAt: String
  isVisibleByEndUser: Boolean!
  isInAllBrands: Boolean!
  _ticketFieldIds: [ID!]!
  ticketFields: [TicketField!]!
  brands: [Brand!]!
  agentConditions: [TicketFormCondition!]!
  endUserConditions: [TicketFormCondition!]!
  formType: String!
}

type ReorderFormsPayload {
  result: ReorderFormsResult!
}

type ReorderFormsResult {
  ticketForms: [TicketForm!]!
}

input TicketFormConditionParentTicketFieldInput {
  id: ID!
}

input TicketFormConditionChildTicketFieldInput {
  id: ID!
}

# start
## Emulates the \`RequiredOnStatuses\` union type w/o polymorphic types.
## (Blame GraphQL's asymmetric type system)
input RequiredOnStatusesInput {
  type: String! # one of \`RequiredOnStatuses\`'s constructor type names.
  # not an enum bc enums need to be "SCREAM_CASE" and more string mapping
  # in the resolvers a'int great.

  # \`statuses\` is only used for the \`RequiredOnSomeStatuses\` constructor
  statuses: [DeprecatedTicketStatus!] # nullable since we can't express this as a union
  customStatuses: [ID!]
}
##
# end

input TicketFormAgentConditionChildInput {
  ticketField: TicketFormConditionChildTicketFieldInput!
  requiredOnStatuses: RequiredOnStatusesInput!
}

input TicketFormEndUserConditionChildInput {
  ticketField: TicketFormConditionChildTicketFieldInput!
  isRequired: Boolean!
}

input SelectedSystemFieldOptionInput {
  value: String!
}

input SelectedCustomFieldOptionInput {
  value: String!
}

input TicketFormAgentConditionInput {
  parentField: TicketFormConditionParentTicketFieldInput!
  childFields: [TicketFormAgentConditionChildInput!]!

  # Can't be polymorphic, so accept all value types
  text: String
  paragraph: String
  priority: SelectedSystemFieldOptionInput
  ticketType: SelectedSystemFieldOptionInput
  selectedOption: SelectedCustomFieldOptionInput
  isChecked: Boolean
}

input TicketFormEndUserConditionInput {
  parentField: TicketFormConditionParentTicketFieldInput!
  childFields: [TicketFormEndUserConditionChildInput!]!

  # Can't be polymorphic, so accept all value types
  text: String
  paragraph: String
  priority: SelectedSystemFieldOptionInput
  ticketType: SelectedSystemFieldOptionInput
  selectedOption: SelectedCustomFieldOptionInput
  isChecked: Boolean
}

input BrandsInput {
  id: ID!
}

input TicketFormTicketFieldInput {
  id: ID!
}

input TicketFormInput {
  agentConditions: [TicketFormAgentConditionInput!]
  endUserConditions: [TicketFormEndUserConditionInput!]
  rawTitle: String
  rawEndUserTitle: String
  isVisibleByEndUser: Boolean
  isInAllBrands: Boolean
  brands: [BrandsInput!]
  ticketFields: [TicketFormTicketFieldInput!]
}

extend type Query {
  ticketForm(id: ID!): TicketForm!
  ticketForms: [TicketForm!]!
}

extend type Mutation {
  createTicketForm(ticketFormInput: TicketFormInput!): TicketForm!
  updateTicketForm(id: ID!, ticketFormInput: TicketFormInput!): TicketForm!
  cloneTicketForm(id: ID!): TicketForm!
  changeTicketFormActiveness(id: ID!, isActive: Boolean!): TicketForm!
  markDefaultTicketForm(id: ID!, rawEndUserTitle: String!): TicketForm!
  reorderTicketForms(ticketFormIds: [ID!]!): ReorderFormsPayload!

  # DELETE returns deleted resource ID
  deleteTicketForm(id: ID!): ID!
}
