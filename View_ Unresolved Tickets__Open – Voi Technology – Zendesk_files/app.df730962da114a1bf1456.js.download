  viewer {
    entity(uri: $uri) {
      uri
      threads(first: $first, after: $after) {
        pageInfo {
          hasNextPage
          endCursor
        }
        edges {
          node {
            __typename
            id
            createdAt
            state
            subject
            creator {
              id
              displayName
            }
            events(collapse: false) {
              edges {
                node {
                  __typename
                  ... on MessageAdded {
                    id
                    timestamp
                    message {
                      id
                      htmlBody
                      from {
                        id
                        displayName
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
