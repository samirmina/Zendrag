"},arguments:[],directives:[]}]}}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"TicketFormTicketTypeCondition"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"ticketType"},arguments:[],directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"name"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"value"},arguments:[],directives:[]}]}}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"TicketFormCheckboxCondition"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"isChecked"},arguments:[],directives:[]}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"TicketFormTextCondition"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"text"},arguments:[],directives:[]}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"TicketFormMultilineCondition"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"paragraph"},arguments:[],directives:[]}]}}]}}]}}]}}],loc:{start:0,end:1111}};function n(e,t){if("FragmentSpread"===e.kind)t.add(e.name.value);else if("VariableDefinition"===e.kind){var i=e.type;"NamedType"===i.kind&&t.add(i.name.value)}e.selectionSet&&e.selectionSet.selections.forEach(function(e){n(e,t)}),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){n(e,t)}),e.definitions&&e.definitions.forEach(function(e){n(e,t)})}t.loc.source={body:`query FormDefinitions {
  ticketForms {
    id
    ticketFields {
      id
      isRequiredForAgent
    }

    agentConditions {
      parentField {
        id
        __typename
      }

      childFields {
        ticketField {
          id
        }
        ... on AgentConditionChild {
          requiredOnStatuses {
            ... on RequiredOnSomeStatuses {
              statuses
              customStatuses
            }
          }
        }
      }

      ... on TicketFormDropdownCondition {
        selectedOption {
          value
          isValid
          customFieldOption {
            id
            name
            value
          }
        }
      }
      ... on TicketFormPriorityCondition {
        priority {
          name
          value
        }
      }
      ... on TicketFormTicketTypeCondition {
        ticketType {
          name
          value
        }
      }
      ... on TicketFormCheckboxCondition {
        isChecked
      }
      ... on TicketFormTextCondition {
        text
      }
      ... on TicketFormMultilineCondition {
        paragraph
      }
    }
  }
}
