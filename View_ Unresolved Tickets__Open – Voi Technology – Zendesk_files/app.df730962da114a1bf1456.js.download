#import '../fragments/LegacyLocalGraphOmniEventsFragment.gql'
#import '../fragments/LegacyLocalGraphCustomEventsFragment.gql'

query customerDefaultOmni($id: ID!, $timezoneOffset: String) {
  # TODO: check if \`id\` field is queriable / valid and include it below
  # eslint-disable-next-line @graphql-eslint/require-id-when-available
  customer(id: $id, timezoneOffset: $timezoneOffset) {
    ...CustomerProfileFields

    events {
      count
      eventList {
        ... on OmniEvent {
          ...OmniEventFields
        }
        ... on CustomEvent {
          ...CustomEventFields
        }
      }
    }

    profiles {
      id
      source
      type
      identifiers {
        type
        value
      }
      namespace {
        ref_id
        name
      }
      attributes
      name
    }

    eventTypes {
      source
      type
      namespace {
        ref_id
        name
      }
    }

    tickets {
      ... on OmniEvent {
        ...OmniEventFields
      }
      ... on CustomEvent {
        ...CustomEventFields
      }
    }
  }
}
