#import 'SideConversations/data/fragments/CollaborationGraphPersonFragment.gql'

fragment MessageFragment on Message {
  __typename
  id
  htmlBody
  via
  previewText
  createdAt
  from {
    id
    ...PersonFragment
  }
  fileAttachments {
    contentType
    id
    name
    size
    url
    previewUrl
    inline
    height
    width
  }
  ... on EmailMessage {
    ccPeople {
      id
      ...ParticipantPersonFragment
    }
    bccPeople {
      id
      ...ParticipantPersonFragment
    }
    toPeople {
      id
      ...ParticipantPersonFragment
    }
