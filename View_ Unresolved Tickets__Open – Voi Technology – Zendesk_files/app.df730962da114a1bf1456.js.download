    page: $page
    perPage: $perPage
    sortBy: $sortBy
    sortOrder: $sortOrder
  ) {
    columns {
      id
      sortable
      title
      type
    }
    count
    rows {
      assignee
      createdAt
      description
      group
      id
      isSelectable
      requester
      status
      subject
      customStatus {
        id
      }
    }
  }
}
