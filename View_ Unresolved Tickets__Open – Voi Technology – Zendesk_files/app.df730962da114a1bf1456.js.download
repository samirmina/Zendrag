#import './LegacyLocalGraphIntervalFragment.gql'
#import './LegacyLocalGraphTimeZoneFragment.gql'

fragment ScheduleResultFragment on ScheduleResult {
  __typename

  ... on Schedule {
    id
    name
    timeZone {
      ...TimeZoneFragment
    }
    intervals {
      ...IntervalFragment
    }
    holidays {
      id
      ...HolidayFragment
    }
    createdAt
    updatedAt
  }

  ... on BusinessHoursErrors {
    errors {
      title
      detail
    }
  }
}
