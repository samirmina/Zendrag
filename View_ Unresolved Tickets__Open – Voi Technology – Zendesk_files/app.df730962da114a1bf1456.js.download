#import 'SideConversations/data/fragments/CollaborationGraphStateChangedFragment.gql'
#import 'SideConversations/data/fragments/CollaborationGraphThreadFragment.gql'

subscription ThreadSubscription($entityUri: String!) {
  entityEvents(entityUri: $entityUri) {
    __typename
    clientMutationId
    ... on UpdateThreadResponse {
      thread {
        id
        ...ThreadFragment
      }
      eventEdges {
        node {
          id
          __typename
          timestamp
          ...StateChangedFragment
        }
      }
    }
    ... on CreateMessageResponse {
      thread {
        id
        ...ThreadFragment
      }
      eventEdges {
        node {
          id
          __typename
          timestamp
          ...MessageAddedFragment
        }
      }
    }
    ... on UpdateMessageResponse {
      thread {
        id
      }
      eventEdges {
        node {
          id
          __typename
          timestamp
          ...MessageAddedFragment
        }
      }
    }
    ... on DeleteMessageResponse {
      thread {
        id
      }
      deletedEventId
    }
  }
}
