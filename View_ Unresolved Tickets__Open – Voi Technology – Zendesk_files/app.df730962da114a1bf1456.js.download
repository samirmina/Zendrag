8}};function n(e,t){if("FragmentSpread"===e.kind)t.add(e.name.value);else if("VariableDefinition"===e.kind){var i=e.type;"NamedType"===i.kind&&t.add(i.name.value)}e.selectionSet&&e.selectionSet.selections.forEach(function(e){n(e,t)}),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){n(e,t)}),e.definitions&&e.definitions.forEach(function(e){n(e,t)})}t.loc.source={body:`# operation.owner: 'box-office'

query printTicketMetadata($id: ID!, $includePriority: Boolean!) {
  ticket(id: $id) {
    id
    subject
    createdAt
    status
    priority @include(if: $includePriority)
    rawVia
    __typename

    customStatus {
      id
      agentLabel
      statusCategory
    }

    requester {
      id
      name
      email
    }

    assignee {
      user {
        id
        name
      }
      group {
        ... on SupportGroup {
          id
          name
        }
      }
    }

    collaborators {
      id
      name
      email
    }

    fields {
      ticketField {
        id
        title
        isActive
        __typename
      }

      ... on TextFieldValue {
        textValue
      }
      ... on NumericFieldValue {
        value
      }
      ... on DecimalFieldValue {
        value
      }
      ... on RegexFieldValue {
        value
      }
      ... on CheckboxFieldValue {
        isChecked
      }
      ... on DateFieldValue {
        date
      }
      ... on MultilineFieldValue {
        paragraph
      }
      ... on MultiselectFieldValue {
        selectedValues
        ticketField {
          id
          options {
            id
            name
            value
          }
        }
      }
      ... on CreditCardFieldValue {
        cardNumber
      }

      ... on DropdownFieldValue {
        selectedOption {
          id
          name
          value
        }
        selectedValue
      }

      ... on TicketTypeFieldValue {
        selectedOption {
          value
        }
      }

      ... on LookupFieldValue {
        lookupValue: value {
          ... on User {
            id
            name
          }
          ... on Ticket {
            id
            subject
          }
          ... on SupportOrganization {
            id
            name
          }
          ... on CustomObjectRecord {
            id
            name
          }
        }
      }
    }
  }
}
