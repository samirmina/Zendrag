mutation CreateTicketThreadMutation(
  $clientMutationId: String
  $entityUri: String!
  $body: String!
  $subject: String!
  $supportAssignableId: ID!
  $fileAttachmentIds: [String!]
  $ticketAttachmentIds: [String!]
  $ticketCreationSpec: TicketCreationSpec
) {
  createTicketThread(
    input: {
      clientMutationId: $clientMutationId
      entityUri: $entityUri
      htmlBody: $body
      subject: $subject
      supportAssignableId: $supportAssignableId
      via: SUPPORT
      fileAttachmentIds: $fileAttachmentIds
      ticketAttachmentIds: $ticketAttachmentIds
      ticketCreationSpec: $ticketCreationSpec
    }
  ) {
    threadEdge {
      node {
        id
        ...ThreadFragment
      }
    }
  }
}
