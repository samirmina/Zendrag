  type: String
  id: ID
  ids: [ID]
}

type Column {
  id: ID
  title: String
}

type GroupByView {
  id: ID
  title: String
  type: String
  order: String
}

type DefaultSortByView {
  id: ID
  order: String
}

type ViewFilterCondition {
  all: [AllFilterCondition]
  any: [AnyFilterCondition]
}

type FilterConditionSingleValue {
  field: String
  operator: String
  value: String
}

type FilterConditionMultiValues {
  field: String
  operator: String
  value: [String]
}

union AllFilterCondition = FilterConditionSingleValue | FilterConditionMultiValues

union AnyFilterCondition = FilterConditionSingleValue | FilterConditionMultiValues

type View {
  active: Boolean
  channel: String
  columns: [Column!]!
  conditions: ViewFilterCondition
  createdAt: String
  danger: Boolean
  defaultSortBy: DefaultSortByView
  groupBy: GroupByView
  hasError: Boolean
  hasSkill: Boolean
  id: ID!
  isFresh: Boolean
  position: Int
  pretty: String
  refresh: String
  restriction: Restriction
  title: String
  url: String
  value: Int
}

type Views {
  results: [View!]!
  count: Int!
}

type Operator {
  value: String
  title: String
  terminal: Boolean
}

type DefinitionValues {
  value: String
  title: String
  enabled: Boolean
}

type Definition {
  group: String
  nullable: Boolean
  operators: [Operator]
  repeatable: Boolean
  subject: String
  title: String
  type: String
  values: [DefinitionValues]
}

type ExportAsCSV {
  view_id: ID
  status: String
}

extend type Query {
  views(access: String, limit: Int, offset: Int): Views
  counts: [View!]!
  view(viewId: ID!): View
  exportAsCSV(query: String): ExportAsCSV
  definitions: [Definition]
}

