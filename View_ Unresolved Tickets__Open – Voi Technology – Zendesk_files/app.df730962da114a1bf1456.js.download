#import "../../timeZones/fragments/LegacyLocalGraphTimeZoneFragment.gql"
#import "./LegacyLocalGraphIdentityFieldsFragment.gql"
#import "./LegacyLocalGraphExternalPermissionsFieldsFragment.gql"
#import "../../organization/queries/LegacyLocalGraphOrganizationFragment.gql"

fragment UserFields on User {
  id
  abilities {
    ...AbilitiesFields
  }
  alias
  details
  name
  email
  avatar
  url
  role
  roleType
  tags
  notes
  locale
  phone
  sharedPhoneNumber
  externalPermissions {
    ...ExternalPermissionsFields
  }
  timeZone {
    ...TimeZoneDefaultFields
  }
  identities {
    ...IdentityFields
  }
  organizations {
    ...OrganizationFragment
  }
  userFields {
    fieldName
    value
  }
  externalId
  signature
  isAssumingUserFromMonitor
}
