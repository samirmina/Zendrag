    commentId: $commentId
    text: $text
    externalAttachmentURLs: $externalAttachmentURLs
  ) {
    success
    error {
      message
    }
    comment {
      id
      body
      plainBody
      htmlBody
      attachments {
        id
        fileName
        contentType
        size
        contentUrl
        thumbnails {
          id
          fileName
          contentType
          size
          contentUrl
        }
      }
    }
  }
}
